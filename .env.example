# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The live address of the site (used for WhatsApp product links, emails and SEO)
NEXT_PUBLIC_SITE_URL=https://biofashionhub.com

# Optional — server only. Needed to add more admins from the dashboard and for `npm run create-admin`.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — email alerts for new enquiries (https://resend.com, free tier)
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Bio Fashion Hub <website@yourdomain.com>"
